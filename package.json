{
  "name": "signal-box",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "format": "bun run format:web && bun run format:rust",
    "format:check": "bun run format:web:check && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:web": "oxfmt src package.json tsconfig.json tsconfig.node.json vite.config.ts",
    "format:web:check": "oxfmt --check src package.json tsconfig.json tsconfig.node.json vite.config.ts",
    "lint": "bun run lint:web && bun run lint:rust",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "lint:web": "oxlint src",
    "check": "bun run format:check && bun run lint && bun run build",
    "db:generate": "drizzle-kit generate",
    "preview": "vite preview",
    "prepare": "husky",
    "tauri": "tauri",
    "ui:add": "shadcn add",
    "ui:info": "shadcn info"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.12.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "shadcn": "^4.6.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
